---
import { Font } from "astro:assets";

import "../styles/global.css";
import "katex/dist/katex-swap.css";

import { Content, frontmatter } from "../paper.mdx";

interface Frontmatter {
  title: string;
  description?: string;
  favicon: string;
  thumbnail?: string;
}

const { title, description, favicon, thumbnail } = frontmatter as Frontmatter;

const baseUrl = import.meta.env.BASE_URL;
const prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";

const nav = [
  { id: "overview", label: "Overview" },
  { id: "method", label: "Method" },
  { id: "results", label: "Results" },
  { id: "qualitative", label: "Examples" },
  { id: "videos", label: "Videos" },
  { id: "distance", label: "Distance test" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {description && <meta name="description" content={description} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />

    <link rel="icon" type="image/svg+xml" href={prefix + favicon} />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    {thumbnail && <meta property="og:image" content={prefix + thumbnail} />}

    <Font cssVariable="--font-inter" preload={[{ subset: "latin", style: "normal" }]} />

    <title>{title}</title>
  </head>
  <body>
    <nav class="topnav" aria-label="Sections">
      <div class="wrap">
        <a class="brand" href="#top">
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          MetricPose
        </a>
        <div class="navlinks">
          {nav.map((n) => <a href={`#${n.id}`} data-nav={n.id}>{n.label}</a>)}
        </div>
      </div>
    </nav>

    <main>
      <Content />
    </main>

    <footer class="footer">
      <div class="wrap">
        <span>Anonymous submission · 2026</span>
        <span>
          Page built on <a href="https://research-template.roman.technology" rel="nofollow">an Astro project-page template</a>
        </span>
      </div>
    </footer>

    <script>
      // Highlight the nav link of the section currently in view.
      const links = new Map<string, HTMLAnchorElement>();
      document.querySelectorAll<HTMLAnchorElement>("[data-nav]").forEach((a) => links.set(a.dataset.nav!, a));
      const sections = [...links.keys()]
        .map((id) => document.getElementById(id))
        .filter((s): s is HTMLElement => !!s);
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              links.forEach((a) => a.classList.remove("active"));
              links.get(e.target.id)?.classList.add("active");
            }
          },
          { rootMargin: "-45% 0px -50% 0px" },
        );
        sections.forEach((s) => io.observe(s));
      }
    </script>
  </body>
</html>
