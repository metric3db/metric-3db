---
const { title, subtitle } = Astro.props;
---

<header class="hero" id="top">
  <div class="wrap">
    <div class="hero-copy">
      <h1><span>{title}</span></h1>
      <p class="subtitle">{subtitle}</p>
      <p class="submission">Anonymous submission · 2026</p>
      <div class="hero-actions">
        <a class="chip" href="#results">Results</a>
        <a class="chip chip-dark" href="#videos">Videos</a>
        <button class="chip chip-dark" type="button" disabled aria-describedby="release-note">Paper</button>
        <button class="chip chip-dark" type="button" disabled aria-describedby="release-note">Code</button>
      </div>
      <p class="release-note" id="release-note">Paper and code will be released after publication.</p>
    </div>
    <div class="hero-figure"><slot /></div>
  </div>
</header>
