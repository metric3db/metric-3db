---
interface Props {
  name: string;
  title: string;
  badge?: string;
  showLegend?: boolean;
}
const { name, title, badge, showLegend } = Astro.props;
const base = import.meta.env.BASE_URL;
const prefix = base.endsWith("/") ? base : base + "/";
---

<figure class="vcard">
  <figcaption class="vcard-header">
    {badge && <span class="vcard-badge">{badge}</span>}
    <h3>{title}</h3>
    <p><slot /></p>
    {showLegend && (
      <div class="vcard-legend" aria-label="Method Color Legend">
        <span class="vcard-pill"><i style="--dot: #ffffff; box-shadow: 0 0 0 1px #94a3b8 inset;"></i>Ground Truth</span>
        <span class="vcard-pill"><i style="--dot: #ffa033;"></i>SAM 3D Body</span>
        <span class="vcard-pill"><i style="--dot: #4db8ff;"></i>Ours (RGB)</span>
        <span class="vcard-pill"><i style="--dot: #82c860;"></i>Ours (RGB + Ground)</span>
        <span class="vcard-pill"><i style="--dot: #ff5c8a;"></i>Ours (RGB-D)</span>
        <span class="vcard-pill"><i style="--dot: #eab308;"></i>Anny-Fit</span>
      </div>
    )}
  </figcaption>
  <div class="vcard-media">
    <video
      data-lazy-video
      muted
      loop
      playsinline
      controls
      preload="none"
      poster={`${prefix}videos/posters/${name}.jpg`}
      aria-label={title}
    >
      <source src={`${prefix}videos/${name}.mp4`} type="video/mp4" />
    </video>
  </div>
</figure>

<script>
  // Play a clip only while it is on screen, and fetch it only when it is about to be.
  const clips = document.querySelectorAll<HTMLVideoElement>("[data-lazy-video]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if ("IntersectionObserver" in window && !reduce) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            v.preload = "auto";
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        }
      },
      { threshold: 0.35 },
    );
    clips.forEach((c) => io.observe(c));
  }
</script>
