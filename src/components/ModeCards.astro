---
const modes = [
  {
    tag: "RGB",
    accent: "var(--c-rgb)",
    text: "var(--t-rgb)",
    title: "Learned priors",
    body: "Learned priors supply initial 3D pose, shape, and camera translation from a single RGB image.",
    adds: "Needs",
    needs: "a single RGB image",
  },
  {
    tag: "RGB + Ground",
    accent: "var(--c-ground)",
    text: "var(--t-ground)",
    title: "A floor and gravity cue",
    body: "Floor plane and gravity constraints anchor the body to correct metric height and distance without depth.",
    adds: "Adds",
    needs: "a floor plane",
  },
  {
    tag: "RGB-D",
    accent: "var(--c-depth)",
    text: "var(--t-depth)",
    title: "Measured surface depth",
    body: "Metric depth directly fixes physical scale and camera distance while refining joint placement.",
    adds: "Adds",
    needs: "a depth map",
  },
];
---

<div class="modes">
  {
    modes.map((m) => (
      <article class="mode" style={`--accent: ${m.accent}; --accent-text: ${m.text}`}>
        <span class="tag"><i></i>{m.tag}</span>
        <h3>{m.title}</h3>
        <p>{m.body}</p>
        <div class="adds"><b>{m.adds}</b> {m.needs}</div>
      </article>
    ))
  }
</div>
